model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PastaDados","fReviews","fTemas","fProdutos","_Medidas"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table _Medidas
ref table fProdutos
ref table fReviews
ref table fTemas
