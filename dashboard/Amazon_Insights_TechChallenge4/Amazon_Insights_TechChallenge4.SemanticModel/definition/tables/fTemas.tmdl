/// Uma linha por avaliação e tema citado
table fTemas
	lineageTag: 336bac8e-059b-a7ad-b9e2-807655dfa45c

	column review_id
		dataType: string
		isHidden
		lineageTag: 6fe976c1-b30d-db98-85c2-adae71012e6f
		summarizeBy: none
		sourceColumn: review_id

		annotation SummarizationSetBy = User

	column tema
		dataType: string
		lineageTag: c03f3282-4282-e07e-5773-c0948c859f69
		summarizeBy: none
		sourceColumn: tema

		annotation SummarizationSetBy = User

	partition fTemas = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(
				        File.Contents(PastaDados & "processed\reviews_temas.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    CabecalhosPromovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    // Sentimento e produto já chegam pela fReviews através do relacionamento
				    ColunasMantidas = Table.SelectColumns(CabecalhosPromovidos, {"review_id", "tema"}),
				    TiposDefinidos = Table.TransformColumnTypes(ColunasMantidas, {{"review_id", type text}, {"tema", type text}})
				in
				    TiposDefinidos

	annotation PBI_ResultType = Table
