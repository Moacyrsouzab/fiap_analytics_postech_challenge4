model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PastaDados","fReviews","fTemas","fProdutos","dPercentil","_Medidas"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table _Medidas
ref table fProdutos
ref table fReviews
ref table fTemas
ref table dPercentil

ref cultureInfo pt-BR

