table _Medidas
	lineageTag: e80ce671-be4d-49fb-fadf-6b029a8abc27

	measure Produtos = DISTINCTCOUNT ( fProdutos[product_id] )
		formatString: #,0
		displayFolder: 1. Visão Executiva
		lineageTag: 7ebc3e2a-de1b-d12c-42bb-2c8bce4598dd

	measure 'Produtos com nota' = CALCULATE ( [Produtos], NOT ISBLANK ( fProdutos[rating] ) )
		formatString: #,0
		displayFolder: 1. Visão Executiva
		lineageTag: 8b190d25-3904-d2a6-f6c1-13e50b86f12a

	measure 'Nota média' = AVERAGE ( fProdutos[rating] )
		formatString: #,0.00
		displayFolder: 1. Visão Executiva
		lineageTag: 8aee4918-4480-2e83-3190-d4cbd79976b0

	measure '% nota ≥ 4,0' = DIVIDE ( CALCULATE ( [Produtos], fProdutos[rating] >= 4 ), [Produtos com nota] )
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: 0176555a-f0b1-91c8-3bf4-d1ad93232a2a

	measure '% nota abaixo de 3,8' = DIVIDE ( CALCULATE ( [Produtos], fProdutos[rating] < 3.8 ), [Produtos com nota] )
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: 728d7a20-44ac-3119-5ab6-61631ca68aeb

	measure Avaliações =
			SUMX (
			    VALUES ( fProdutos[familia] ),
			    CALCULATE ( MAX ( fProdutos[rating_count] ) )
			)
		formatString: #,0
		displayFolder: 1. Visão Executiva
		lineageTag: a1b7077f-a0d2-8352-395f-4ffbce8e4849

	measure 'Famílias de produtos' = DISTINCTCOUNT ( fProdutos[familia] )
		formatString: #,0
		displayFolder: 1. Visão Executiva
		lineageTag: 21f053cf-5f2a-2028-cabc-013728dc820c

	measure 'Avaliações por produto (mediana)' = CALCULATE ( MEDIAN ( fProdutos[rating_count] ), NOT ISBLANK ( fProdutos[rating] ) )
		formatString: #,0
		displayFolder: 1. Visão Executiva
		lineageTag: e539f545-61c9-4e86-c6df-9ebe84d26544

	measure 'Desconto médio' = CALCULATE ( AVERAGE ( fProdutos[desconto] ), NOT ISBLANK ( fProdutos[rating] ) )
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: 52576e7c-591d-5407-34f7-4bc75db73d5a

	measure 'Preço original mediano' = CALCULATE ( MEDIAN ( fProdutos[actual_price] ), NOT ISBLANK ( fProdutos[rating] ) )
		formatString: \₹#,0
		displayFolder: 1. Visão Executiva
		lineageTag: 18696955-86d9-4097-f49c-d14d65f7aa58

	measure 'Preço final mediano' = CALCULATE ( MEDIAN ( fProdutos[discounted_price] ), NOT ISBLANK ( fProdutos[rating] ) )
		formatString: \₹#,0
		displayFolder: 1. Visão Executiva
		lineageTag: e9ae5328-184e-1957-38c7-b978b0c01652

	measure 'Economia média' = CALCULATE ( AVERAGE ( fProdutos[economia] ), NOT ISBLANK ( fProdutos[rating] ) )
		formatString: \₹#,0
		displayFolder: 1. Visão Executiva
		lineageTag: f022468b-0fdd-0181-58b7-9ae54d473206

	measure '% do portfólio' =
			DIVIDE (
			    [Produtos com nota],
			    CALCULATE ( [Produtos com nota], ALLSELECTED ( fProdutos[categoria], fProdutos[subcategoria] ) )
			)
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: 12bb571c-6d08-6e52-9daf-356c0bd351bf

	measure '% das avaliações' =
			DIVIDE (
			    [Avaliações],
			    CALCULATE ( [Avaliações], ALLSELECTED ( fProdutos[categoria], fProdutos[subcategoria] ) )
			)
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: a6d02739-6550-a70e-7ae3-518520287ced

	measure 'Concentração top 10%' =
			VAR Familias =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( fProdutos[familia] ),
			            "@aval", CALCULATE ( MAX ( fProdutos[rating_count] ) )
			        ),
			        NOT ISBLANK ( [@aval] )
			    )
			VAR Qtd = INT ( COUNTROWS ( Familias ) * 0.1 )
			VAR Topo = TOPN ( Qtd, Familias, [@aval], DESC )
			RETURN
			    DIVIDE ( SUMX ( Topo, [@aval] ), SUMX ( Familias, [@aval] ) )
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: da0b5ce9-9318-3792-62cf-7b2fe87d4005

	measure 'Nota ponderada média' = AVERAGE ( fProdutos[nota_ponderada] )
		formatString: #,0.00
		displayFolder: 2. Produtos e Categorias
		lineageTag: ed338ccf-340d-5ce6-735a-bebf7203f898

	measure 'Produtos em risco de reputação' = CALCULATE ( [Produtos], fProdutos[risco_reputacao] = TRUE () )
		formatString: #,0
		displayFolder: 2. Produtos e Categorias
		lineageTag: 0d7970ea-f405-5978-34dd-24f687828e14

	measure 'Famílias em risco de reputação' = CALCULATE ( [Famílias de produtos], fProdutos[risco_reputacao] = TRUE () )
		formatString: #,0
		displayFolder: 2. Produtos e Categorias
		lineageTag: 156fef99-78d8-d2fc-efda-5d2bc174f813

	measure 'Famílias com oportunidade de visibilidade' = CALCULATE ( [Famílias de produtos], fProdutos[oportunidade_visibilidade] = TRUE () )
		formatString: #,0
		displayFolder: 2. Produtos e Categorias
		lineageTag: 8f9a0fd8-b09a-13e1-88f6-bfbff5b6ab0e

	measure 'Produtos com alerta nos comentários' = CALCULATE ( [Produtos], fProdutos[alerta_comentarios] = TRUE () )
		formatString: #,0
		displayFolder: 2. Produtos e Categorias
		lineageTag: 4ca6ed0c-b80b-8d08-9d90-e555c6d5fe8c

	measure '% com desconto acima de 60%' = DIVIDE ( CALCULATE ( [Produtos com nota], fProdutos[discount_percentage] > 60 ), [Produtos com nota] )
		formatString: 0.0%
		displayFolder: 3. Preços
		lineageTag: 18992a2d-9227-edda-f8e5-1410f5bb7e0b

	measure '% nota ≥ 4,0 com até 20% de desconto' = CALCULATE ( [% nota ≥ 4,0], fProdutos[faixa_desconto] = "0-20%" )
		formatString: 0.0%
		displayFolder: 3. Preços
		lineageTag: 5b5e49c2-af54-310d-4b07-df35972f96ae

	measure '% nota ≥ 4,0 com mais de 80% de desconto' = CALCULATE ( [% nota ≥ 4,0], fProdutos[faixa_desconto] = "81-94%" )
		formatString: 0.0%
		displayFolder: 3. Preços
		lineageTag: 2a6e1845-21fe-f398-b398-67db89a99b43

	measure 'Avaliações de texto' = COUNTROWS ( fReviews )
		formatString: #,0
		displayFolder: 4. Customer Insights
		lineageTag: f7b209ca-d6c4-4bcb-6238-4b99e6cff9d4

	measure '% avaliações positivas' = DIVIDE ( CALCULATE ( [Avaliações de texto], fReviews[sentimento] = "Positiva" ), [Avaliações de texto] )
		formatString: 0.0%
		displayFolder: 4. Customer Insights
		lineageTag: 702c47a7-27c3-f195-48bd-b741b15f24e0

	measure '% avaliações negativas' = DIVIDE ( CALCULATE ( [Avaliações de texto], fReviews[sentimento] = "Negativa" ), [Avaliações de texto] )
		formatString: 0.0%
		displayFolder: 4. Customer Insights
		lineageTag: e052d724-43e6-9cc7-40a7-4f7ddcc56a6f

	measure 'Sentimento médio' = AVERAGE ( fReviews[score_sentimento] )
		formatString: 0.000
		displayFolder: 4. Customer Insights
		lineageTag: 3502225e-5427-1a46-566c-fe57f45138a1

	measure 'Menções ao tema' = COUNTROWS ( fTemas )
		formatString: #,0
		displayFolder: 4. Customer Insights
		lineageTag: 1413820a-c13f-88b0-499c-41a750427210

	measure '% das avaliações que citam o tema' = DIVIDE ( [Menções ao tema], [Avaliações de texto] )
		formatString: 0.0%
		displayFolder: 4. Customer Insights
		lineageTag: 3dda6c5f-f7de-58c5-2fe7-f2275579ffa4

	measure '% negativas quando cita o tema' = DIVIDE ( CALCULATE ( [Menções ao tema], fReviews[sentimento] = "Negativa" ), [Menções ao tema] )
		formatString: 0.0%
		displayFolder: 4. Customer Insights
		lineageTag: 10547500-a769-37c4-371a-ec9a1ff81562

	measure '% positivas quando cita o tema' = DIVIDE ( CALCULATE ( [Menções ao tema], fReviews[sentimento] = "Positiva" ), [Menções ao tema] )
		formatString: 0.0%
		displayFolder: 4. Customer Insights
		lineageTag: f47a7c48-37a0-5a1b-1dd0-56fdda61474d

	measure 'Vezes a média negativa' = DIVIDE ( [% negativas quando cita o tema], [% avaliações negativas] )
		formatString: 0.0
		displayFolder: 4. Customer Insights
		lineageTag: e3a938b2-ec19-9052-e2f2-5e97b57925f6

	measure '% cita durabilidade' =
			DIVIDE (
			    CALCULATE ( [Menções ao tema], fTemas[tema] = "Durabilidade e defeitos" ),
			    [Avaliações de texto]
			)
		formatString: 0.0%
		displayFolder: 4. Customer Insights
		lineageTag: 4d5363f2-afa9-7190-df4a-378840126da6

	measure '% negativas sobre durabilidade' = CALCULATE ( [% negativas quando cita o tema], fTemas[tema] = "Durabilidade e defeitos" )
		formatString: 0.0%
		displayFolder: 4. Customer Insights
		lineageTag: 908cbeb2-67e1-b3c1-629f-c393ef41792f

	measure 'Aviso sem avaliações de texto' =
			IF (
			    ISBLANK ( [Avaliações de texto] ),
			    "Este produto não tem avaliações de texto na amostra analisada (variante de outro anúncio ou texto sem separação confiável).",
			    BLANK ()
			)
		displayFolder: 4. Customer Insights
		lineageTag: 1e7b3bbf-f5d0-053e-e77d-0ef1566c42de

	measure 'Filtro tema da avaliação' =
			// 1 quando nenhum tema está selecionado ou quando a avaliação cita o tema escolhido
			IF ( NOT ISFILTERED ( fTemas[tema] ) || [Menções ao tema] > 0, 1 )
		formatString: 0
		displayFolder: 4. Customer Insights
		lineageTag: dbcb05cf-168e-6ff9-108f-b860e834c0ce

	measure 'Título Visão Executiva' =
			FORMAT ( [Produtos], "#,0" ) & " produtos, nota média "
			    & FORMAT ( [Nota média], "0.00" ) & " e "
			    & FORMAT ( [% nota ≥ 4,0], "0%" ) & " deles com nota 4,0 ou mais"
		displayFolder: 5. Títulos
		lineageTag: 3695759b-47ef-b232-99d0-7d5b58bed6cf

	measure 'Título Desconto' =
			"Acima de 80% de desconto, só "
			    & FORMAT ( [% nota ≥ 4,0 com mais de 80% de desconto], "0%" )
			    & " têm nota ≥ 4,0 ("
			    & FORMAT ( [% nota ≥ 4,0 com até 20% de desconto], "0%" ) & " com até 20%)"
		displayFolder: 5. Títulos
		lineageTag: 735bd7fb-305c-f41d-73d7-2f1a0facf38e

	measure 'Título Temas' =
			"Quando citam durabilidade, "
			    & FORMAT ( [% negativas sobre durabilidade], "0%" )
			    & " são negativas (média: "
			    & FORMAT ( [% avaliações negativas], "0%" ) & ")"
		displayFolder: 5. Títulos
		lineageTag: f2b379be-f1da-e251-73aa-ee1856f18f5d

	measure 'Concentração acumulada' =
			// Curva de Pareto: parte das avaliações que fica com os p% de famílias mais avaliadas
			VAR p = SELECTEDVALUE ( dPercentil[Percentil] )
			VAR Familias =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( fProdutos[familia] ),
			            "@aval", CALCULATE ( MAX ( fProdutos[rating_count] ) )
			        ),
			        NOT ISBLANK ( [@aval] )
			    )
			VAR Qtd = INT ( COUNTROWS ( Familias ) * p )
			VAR Topo = TOPN ( Qtd, Familias, [@aval], DESC )
			RETURN
			    IF ( NOT ISBLANK ( p ), DIVIDE ( SUMX ( Topo, [@aval] ), SUMX ( Familias, [@aval] ) ) + 0 )
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: 11efc1d8-aa1f-4ae4-afaa-e11f264ce1d1

	measure 'Linha de igualdade' =
			// Referência: como seria se todos os produtos tivessem o mesmo número de avaliações
			SELECTEDVALUE ( dPercentil[Percentil] )
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: 6dba1e7b-ed66-4d56-b3eb-9fddd1b00aac

	measure 'Título Pareto' =
			"10% dos produtos mais avaliados concentram "
			    & FORMAT ( [Concentração top 10%], "0%" ) & " das avaliações"
		displayFolder: 5. Títulos
		lineageTag: 79f1a51b-17a3-432b-bae7-60c258f77d10

	measure '% dos produtos no grupo' =
			
			DIVIDE ( [Produtos], CALCULATE ( [Produtos], ALLSELECTED ( fProdutos[quadrante], fProdutos[ordem_quadrante] ) ) )
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: 71767d98-5bd7-4d3b-969e-929fbd994869

	measure '% das avaliações no grupo' =
			
			DIVIDE ( [Avaliações], CALCULATE ( [Avaliações], ALLSELECTED ( fProdutos[quadrante], fProdutos[ordem_quadrante] ) ) )
		formatString: 0.0%
		displayFolder: 1. Visão Executiva
		lineageTag: 721e9a56-44e8-4314-956b-e5b1dc8dde18

	measure 'Título Quadrantes' =
			VAR Grupo = "Atenção: alcance alto, nota baixa"
			VAR Qtd = CALCULATE ( [Produtos], fProdutos[quadrante] = Grupo )
			VAR Pct = DIVIDE ( CALCULATE ( [Avaliações], fProdutos[quadrante] = Grupo ), CALCULATE ( [Avaliações], ALLSELECTED ( fProdutos[quadrante] ) ) )
			RETURN
			    FORMAT ( Qtd, "#,0" ) & " produtos muito vistos com nota abaixo de 4,0 somam " & FORMAT ( Pct, "0%" ) & " das avaliações"
		displayFolder: 5. Títulos
		lineageTag: b91b1921-19cd-4359-b35a-dcf49dc64cc7

	measure '% nota ≥ 4,0 (células com 8+ produtos)' =
			// Mapa de calor preço × desconto: esconde as células com poucos produtos
			IF ( [Produtos com nota] >= 8, [% nota ≥ 4,0] )
		formatString: 0.0%
		displayFolder: 3. Preços
		lineageTag: 1d00666d-6168-40df-9973-a85cf5438775

	measure '% nota ≥ 4,0 (subcategorias com 15+ produtos)' =
			// Ranking de subcategorias: só as que têm amostra suficiente
			IF ( [Produtos com nota] >= 15, [% nota ≥ 4,0] )
		formatString: 0.0%
		displayFolder: 2. Produtos e Categorias
		lineageTag: f46474f6-9f62-4d70-832f-1c5fc5a3febd

	column Coluna1
		dataType: string
		lineageTag: 69c05e94-822f-49fb-c639-096f207b4028
		summarizeBy: none
		sourceColumn: Coluna1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Medidas = m
		mode: import
		source =
				let
				    // Tabela vazia: serve só para guardar as medidas no topo da lista de campos
				    Fonte = #table(type table [Coluna1 = text], {})
				in
				    Fonte

	annotation PBI_ResultType = Table

