{
  "name": "Amazon Insights - Tech Challenge Fase 4",
  "dataColors": [
    "#1B4965",
    "#E07A1F",
    "#B8C0C8",
    "#2E7D5B",
    "#B23A48",
    "#5FA8D3",
    "#8E9AA6",
    "#CAE9FF"
  ],
  "good": "#2E7D5B",
  "neutral": "#B8C0C8",
  "bad": "#B23A48",
  "maximum": "#1B4965",
  "center": "#B8C0C8",
  "minimum": "#E07A1F",
  "background": "#FFFFFF",
  "foreground": "#2B2B2B",
  "tableAccent": "#1B4965",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B4965"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#2B2B2B"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#2B2B2B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4A4A4A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#2B2B2B" } },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E3E7EB" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          { "show": false }
        ],
        "valueAxis": [
          {
            "gridlineColor": { "solid": { "color": "#EEF1F4" } },
            "labelColor": { "solid": { "color": "#4A4A4A" } }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#4A4A4A" } }
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#2B2B2B" } },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F5F7" } },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "border": [
          { "show": false }
        ]
      }
    }
  }
}
