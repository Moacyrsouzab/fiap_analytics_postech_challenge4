{
  "name": "Amazon Insights - Tech Challenge Fase 4",
  "dataColors": [
    "#1B4965",
    "#E07A1F",
    "#9DB3C6",
    "#2E7D5B",
    "#B23A48",
    "#5FA8D3",
    "#8E9AA6",
    "#CAE9FF"
  ],
  "good": "#2E7D5B",
  "neutral": "#B8C0C8",
  "bad": "#B23A48",
  "maximum": "#1B4965",
  "center": "#B8C0C8",
  "minimum": "#E07A1F",
  "background": "#FFFFFF",
  "foreground": "#2B2B2B",
  "tableAccent": "#1B4965",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B4965"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2A33"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#2B2B2B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4A4A4A"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#2B2B2B"
              }
            },
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#EEF1F4"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#4A4A4A"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#4A4A4A"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#2B2B2B"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}